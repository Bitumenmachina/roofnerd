# roofnerd — the public repo carries the application, the synthetic demo job, and
# the gates. Real bid numbers and the ruling documents stay on the estimator's box.

node_modules/
dist/
target/
*.tsbuildinfo
.DS_Store
*.swp
*~

# Local-only. Real jobs carry client names, quantities and unit prices; none of it
# is anyone else's business, and none of it is needed to run or check this program.
fixtures/
refs/
evidence/
work/
out/

# Generated by tauri-build on every compile
/src-tauri/gen/schemas

# Drawings added to a job through the program land in that job's folder. The
# demo job is IN this repository, so anything opened into it while the program
# is running would be committed with it — and the first thing that happened when
# the program was handed over was a scan from a real office landing here.
#
# Only the demo's own synthetic sheet is tracked. Every other drawing in any
# job folder stays out, whatever it is.
jobs/*/pages/*.pdf
jobs/*/pages/*.png
jobs/*/pages/*.jpg
jobs/*/pages/*.jpeg
jobs/*/pages/*.webp
!jobs/demo-job/pages/roof-plan.pdf


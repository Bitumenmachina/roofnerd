+    }
+
+    /// A gable plane 24 ft along the eave and 8 ft up the slope: an edge rafter at each rake and
+    /// marks 1 to 11 at 24 in: 13 rafters of 8 ft on plan (24 / 2 + 1).
+    #[test]
+    fn a_gable_plane_has_13_rafters_of_8_ft_on_plan() {

+    let part = h.part.clone();
+    let before = save(&mut h.job);
+    let why = ed::move_wall(&mut h.job, &part, 20.0, 0.0, known(), false).unwrap_err();
+    assert!(why.contains("would no longer meet wall 1"), "{why}");

+    let cross = ed::walls(&mut job, &level, &w6, &[[24.0, 8.0], [30.0, 8.0]], false, ed::Top::Height("9 ft"), known()).unwrap()[0].clone();
+    let moved = ed::move_wall(&mut job, &outer[1], -3.0, 0.0, known(), false).unwrap();

@@ -0,0 +1,97 @@
+//! A page of line work: fills and lines in points on a sheet of paper, the lettering of
+//! strokes, and the PDF they are written out as. It is the display list of BIMCraft's plan
+//! pass, cut to what a plan set draws.
+//!
+//! PORTED CODE, in the files of this folder, each of which says what it was ported from
+//! and what was changed. This file takes the shape of BIMCraft's display list
+//! (`crates/core/src/render.rs:88`, `Prim`; `render.rs:215`, `Drawing`) at commit
+//! f202abd85d1cf165325e2f7b250da0b5e51f5b71 (2026-11-10), https://github.com/IPedrax/bimcraft,
+//! Copyright (c) 2026 IPedrax and the BIMCraft contributors, used under the MIT license
+//! (BIMCraft is MIT OR Apache-2.0). The notice is in NOTICE at the repository root.
+//!
+//! What was changed, and nothing else:
+//! * A page's unit is the point (1/72 in) with y up, where BIMCraft's is a pixel of its view
+//!   with y down; there is no view, so no scale between pixels and millimetres: a line's
+//!   width is already in points (`pen::points`).
+//! * Only a fill (`Prim::Fill`) and a line (`Prim::Line`) are taken. BIMCraft's third
+//!   primitive, a picture, a page of a plan set has none. Of a primitive's owner, its part
+//!   and its pen (for picking and overrides) only the one thing the PDF needs of its part
+//!   is kept: whether a line's corners are mitred (`Part::mitred`, `render.rs:67`: all but
+//!   lettering, whose strokes turn round so a V's point does not stick out).
+//! * `Drawing::text` (`render.rs:428`, `text_turned`, `render.rs:449`) letters text centred
+//!   on a point, turned an angle, in strokes a tenth of its height wide; here a stroke is
+//!   never under half a point.
+
+pub mod cut;
+pub mod font;
+pub mod pdf;
+pub mod pen;
+pub mod size;
+
+/// A colour, 0 to 255 each of red, green and blue.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Rgb(pub u8, pub u8, pub u8);
+
+/// The paper (`render.rs:44`).
+pub const PAPER: Rgb = Rgb(255, 255, 255);
+/// A cut wall's fill (`render.rs:46`).
+pub const POCHE: Rgb = Rgb(168, 168, 168);
+/// Ink (`render.rs:49`).
+pub const INK: Rgb = Rgb(25, 25, 25);
+/// What is seen and not cut, or stays (`render.rs:50`).
+pub const FAINT: Rgb = Rgb(120, 120, 120);
+
+/// One thing drawn.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Prim {
+    /// Rings filled in one colour, as a single shape: where rings overlap they are one.
+    Fill { rings: Vec<Vec<(f32, f32)>>, color: Rgb },
+    /// A line through points, `width` points wide; dashed (its on and off lengths in points,
+    /// again and again) or solid; closed or open; its corners turned round when `round`.
+    Line { pts: Vec<(f32, f32)>, width: f32, color: Rgb, dash: Option<Vec<f32>>, closed: bool, round: bool },
+}
+
+/// A page: its size in points and what is drawn on it, in the order drawn.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Drawing {
+    pub width: f32,
+    pub height: f32,
+    pub prims: Vec<Prim>,
+}
+
+impl Drawing {
+    pub fn new(width: f32, height: f32) -> Drawing {
+        Drawing { width, height, prims: Vec::new() }
+    }
+
+    pub fn fill(&mut self, rings: Vec<Vec<(f32, f32)>>, color: Rgb) {
+        if !rings.is_empty() {
+            self.prims.push(Prim::Fill { rings, color });
+        }
+    }
+
+    /// A line, corners mitred (a cut wall's corner is square).
+    pub fn line(&mut self, pts: Vec<(f32, f32)>, width: f32, color: Rgb, dash: Option<Vec<f32>>, closed: bool) {
+        if pts.len() >= 2 {
+            self.prims.push(Prim::Line { pts, width, color, dash, closed, round: false });
+        }
+    }
+
+    /// `text` centred on `(x, y)`, capitals `height` points tall, turned `angle` radians
+    /// counter-clockwise; each stroke turns round at its corners.
+    pub fn text(&mut self, text: &str, (x, y): (f32, f32), height: f32, angle: f32, color: Rgb) {
+        let (s, c) = angle.sin_cos();
+        let w = font::width(text, height);
+        for pts in font::strokes(text, -w / 2.0, -height / 2.0, height) {
+            let pts = pts.into_iter().map(|(a, b)| (x + a * c - b * s, y + a * s + b * c)).collect();
+            self.prims.push(Prim::Line { pts, width: (height / 10.0).max(0.5), color, dash: None, closed: false, round: true });
+        }
+    }
+
+    /// `text` with its left end at `(x, y)` on the baseline, level.
+    pub fn text_left(&mut self, text: &str, (x, y): (f32, f32), height: f32, color: Rgb) {
+        for pts in font::strokes(text, x, y, height) {
+            self.prims.push(Prim::Line { pts, width: (height / 10.0).max(0.5), color, dash: None, closed: false, round: true });
+        }
+    }
+}
diff --git a/plumbline/crates/world/src/paper/pdf.rs b/plumbline/crates/world/src/paper/pdf.rs
new file mode 100644
index 0000000..2c65633
--- /dev/null
+++ b/plumbline/crates/world/src/paper/pdf.rs
@@ -0,0 +1,155 @@
+//! A PDF written by hand (PDF 1.4): a page a drawing, its fills and lines as paths, its
+//! lettering strokes, so a page needs no fonts. Streams are deflated.
+//!
+//! PORTED CODE. Ported from BIMCraft, `crates/core/src/pdf.rs`, at commit
+//! f202abd85d1cf165325e2f7b250da0b5e51f5b71 (2026-11-10), https://github.com/IPedrax/bimcraft,
+//! Copyright (c) 2026 IPedrax and the BIMCraft contributors, used under the MIT license
+//! (BIMCraft is MIT OR Apache-2.0). The notice is in NOTICE at the repository root.
+//!
+//! What was changed, and nothing else:
+//! * `contents` (`pdf.rs:25`) and `pdf` (`pdf.rs:68`) are taken: objects numbered the same
+//!   way (1 the catalog, 2 the page tree, then each page and its contents), the
+//!   cross-reference table of twenty bytes an entry, the same operators for fills (`rg`,
+//!   `f`) and lines (`RG`, `w`, `j`, `d`, `S`).
+//! * A page's drawing is already in points with y up (`paper::Drawing`), so BIMCraft's
+//!   matrix from pixels to points (`pdf.rs:27`) is not written, and the page's size is the
+//!   drawing's. The pictures a page of BIMCraft's may hold (`/Im0`, an image's object and
+//!   its mask) are not taken: a plan set has none.
+//! * A line's width and a dash's lengths are in points, written as they are.
+//! * The same drawings give the same bytes: nothing here reads a clock.
+
+use std::fmt::Write as _;
+use std::io::Write as _;
+
+use flate2::write::ZlibEncoder;
+use flate2::Compression;
+
+use super::{Drawing, Prim, Rgb};
+
+fn deflate(bytes: &[u8]) -> Vec<u8> {
+    let mut z = ZlibEncoder::new(Vec::new(), Compression::default());
+    // Writing into a Vec can't fail.
+    let _ = z.write_all(bytes);
+    z.finish().unwrap_or_default()
+}
+
+fn color(c: Rgb) -> String {
+    format!("{:.3} {:.3} {:.3}", f32::from(c.0) / 255.0, f32::from(c.1) / 255.0, f32::from(c.2) / 255.0)
+}
+
+fn path(s: &mut String, pts: &[(f32, f32)], closed: bool) {
+    for (i, (x, y)) in pts.iter().enumerate() {
+        let _ = write!(s, "{x:.2} {y:.2} {} ", if i == 0 { "m" } else { "l" });
+    }
+    if closed {
+        s.push_str("h ");
+    }
+}
+
+/// A page's content stream.
+pub(crate) fn contents(d: &Drawing) -> String {
+    let mut s = String::from("1 J 0 j\n");
+    for p in &d.prims {
+        match p {
+            Prim::Fill { rings, color: c } => {
+                let _ = write!(s, "{} rg ", color(*c));
+                for r in rings {
+                    path(&mut s, r, true);
+                }
+                s.push_str("f\n");
+            }
+            Prim::Line { pts, width, color: c, dash, closed, round } => {
+                let dash = dash.as_ref().map_or_else(|| "[] 0 d".to_string(), |d| format!("[{}] 0 d", d.iter().map(|x| format!("{x:.2}")).collect::<Vec<_>>().join(" ")));
+                let _ = write!(s, "{} RG {width:.3} w {} j {dash} ", color(*c), if *round { 1 } else { 0 });
+                path(&mut s, pts, *closed);
+                s.push_str("S\n");
+            }
+        }
+    }
+    s
+}
+
+/// The pages, each a drawing the size of its paper, as a PDF file.
+pub fn pdf(pages: &[Drawing]) -> Vec<u8> {
+    let mut out: Vec<u8> = b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n".to_vec();
+    let mut offsets = vec![0usize; 3];
+    let object = |out: &mut Vec<u8>, offsets: &mut Vec<usize>, n: usize, dict: &str, stream: Option<&[u8]>| {
+        if offsets.len() <= n {
+            offsets.resize(n + 1, 0);
+        }
+        if let Some(o) = offsets.get_mut(n) {
+            *o = out.len();
+        }
+        out.extend(format!("{n} 0 obj\n{dict}\n").bytes());
+        if let Some(bytes) = stream {
+            out.extend(b"stream\n");
+            out.extend(bytes);
+            out.extend(b"\nendstream\n");
+        }
+        out.extend(b"endobj\n");
+    };
+    // 1 the catalog, 2 the page tree; then a page and its contents, page by page.
+    let mut kids = Vec::new();
+    let mut next = 3;
+    for d in pages {
+        let (page, stream) = (next, next + 1);
+        next = stream + 1;
+        kids.push(format!("{page} 0 R"));
+        let dict = format!("<< /Type /Page /Parent 2 0 R /MediaBox [0 0 {:.3} {:.3}] /Resources << >> /Contents {stream} 0 R >>", d.width, d.height);
+        object(&mut out, &mut offsets, page, &dict, None);
+        let body = deflate(contents(d).as_bytes());
+        object(&mut out, &mut offsets, stream, &format!("<< /Length {} /Filter /FlateDecode >>", body.len()), Some(&body));
+    }
+    object(&mut out, &mut offsets, 1, "<< /Type /Catalog /Pages 2 0 R >>", None);
+    object(&mut out, &mut offsets, 2, &format!("<< /Type /Pages /Kids [{}] /Count {} >>", kids.join(" "), kids.len()), None);
+    let start = out.len();
+    let mut xref = format!("xref\n0 {next}\n0000000000 65535 f \n");
+    for n in 1..next {
+        // Twenty bytes an entry: the space before the line feed is the PDF's.
+        let _ = writeln!(xref, "{:010} 00000 n ", offsets.get(n).copied().unwrap_or(0));
+    }
+    let _ = write!(xref, "trailer\n<< /Size {next} /Root 1 0 R >>\nstartxref\n{start}\n%%EOF\n");
+    out.extend(xref.bytes());
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn page() -> Drawing {
+        let mut d = Drawing::new(288.0, 216.0);
+        d.line(vec![(10.0, 10.0), (82.0, 10.0)], 1.0, super::super::INK, None, false);
+        d.fill(vec![vec![(20.0, 20.0), (40.0, 20.0), (40.0, 40.0)]], super::super::POCHE);
+        d
+    }
+
+    #[test]
+    fn the_cross_reference_table_points_at_every_object() {
+        let bytes = pdf(&[page(), page()]);
+        let tail = String::from_utf8_lossy(&bytes[bytes.len() - 40..]).to_string();
+        let start: usize = tail.split("startxref\n").nth(1).unwrap().lines().next().unwrap().parse().unwrap();
+        let table = String::from_utf8_lossy(&bytes[start..]).to_string();
+        let mut lines = table.lines().skip(1);
+        let count: usize = lines.next().unwrap().split(' ').nth(1).unwrap().parse().unwrap();
+        assert_eq!(count, 1 + 2 + 2 * 2, "the free entry, catalog and pages, and a page and its contents twice");
+        for (n, entry) in lines.skip(1).take(count - 1).enumerate() {
+            let offset: usize = entry[..10].parse().unwrap();
+            let head = format!("{} 0 obj", n + 1);
+            assert!(bytes[offset..].starts_with(head.as_bytes()), "object {} isn't at {offset}", n + 1);
+        }
+        assert!(bytes.ends_with(b"%%EOF\n"));
+    }
+
+    #[test]
+    fn the_same_drawings_are_the_same_bytes() {
+        assert_eq!(pdf(&[page()]), pdf(&[page()]));
+    }
+
+    #[test]
+    fn a_page_is_the_size_of_its_drawing() {
+        let bytes = pdf(&[page()]);
+        let text = String::from_utf8_lossy(&bytes);
+        assert!(text.contains("/MediaBox [0 0 288.000 216.000]"));
+    }
+}
diff --git a/plumbline/crates/world/src/paper/pen.rs b/plumbline/crates/world/src/paper/pen.rs
new file mode 100644
index 0000000..21db61a
--- /dev/null
+++ b/plumbline/crates/world/src/paper/pen.rs
@@ -0,0 +1,90 @@
+//! Pens: how wide a line is on paper. A line's weight is a pen, 1 to 16 as in Revit, each a
+//! width in paper millimetres, so it prints the same on any paper.
+//!
+//! PORTED CODE. Ported from BIMCraft, `crates/core/src/pen.rs`, at commit
+//! f202abd85d1cf165325e2f7b250da0b5e51f5b71 (2026-11-10), https://github.com/IPedrax/bimcraft,
+//! Copyright (c) 2026 IPedrax and the BIMCraft contributors, used under the MIT license
+//! (BIMCraft is MIT OR Apache-2.0). The notice is in NOTICE at the repository root.
+//!
+//! What was changed, and nothing else:
+//! * `WIDTHS` (`pen.rs:34`) and the pens a drawing uses (`Pen::CUT`, `BORDER`, `HEAVY`,
+//!   `MEDIUM`, `PROJECTION`, `FINE`; `pen.rs:40` to `pen.rs:55`) are taken as they are, as
+//!   constants (pen numbers).
+//! * `LineWeights::default_for` and `LineWeights::at` (`pen.rs:136`, `pen.rs:154`) are taken
+//!   for the imperial scales (12, 24, 48, 96, 192, 384) and as two functions: the model's
+//!   pens widen at finer scales and thin at coarser ones by the fourth root of how many
+//!   times finer, to the hundredth of a millimetre, taking the column of the scale nearest
+//!   (by how many times, the finer of two as near); the annotation's pens are the widths
+//!   themselves. A project's own line weights (`LineWeights` as a saved thing) are not taken:
+//!   a plan set has the starting ones.
+//! * A pen is a `u8`, where BIMCraft's is a type of its own with a reader that refuses a
+//!   fraction.
+
+pub type Pen = u8;
+
+/// What a cut passes through, outlined: walls in plan.
+pub const CUT: Pen = 10;
+/// A sheet's border and its title block's frame.
+pub const BORDER: Pen = 8;
+/// Heavy: an opening's jambs, a dimension's ticks.
+pub const HEAVY: Pen = 7;
+/// Medium: a door's leaf.
+pub const MEDIUM: Pen = 6;
+/// What is seen beyond the cut, and annotation's lines: dimensions, lettering's strokes.
+pub const PROJECTION: Pen = 4;
+/// The finest.
+pub const FINE: Pen = 1;
+
+/// The widest pen.
+pub const MAX_PEN: u8 = 16;
+
+/// Each pen's width on paper at 1 : 100, mm, from pen 0 (a hairline, no width of its own) up.
+const WIDTHS: [f64; MAX_PEN as usize + 1] = [0.0, 0.10, 0.13, 0.15, 0.18, 0.20, 0.22, 0.25, 0.28, 0.30, 0.35, 0.40, 0.50, 0.70, 1.00, 1.40, 2.00];
+
+/// The scales a project in feet and inches draws at, 1 : n, as BIMCraft starts it
+/// (`pen.rs:140`).
+const SCALES: [f64; 6] = [12.0, 24.0, 48.0, 96.0, 192.0, 384.0];
+
+/// How wide a pen draws a line of the annotation (lettering, dimensions), mm on paper.
+pub fn annotation_mm(pen: Pen) -> f64 {
+    WIDTHS.get(usize::from(pen)).copied().unwrap_or(0.0)
+}
+
+/// How wide a pen draws the model (walls, openings) on a plan at 1 : `n`, mm on paper.
+pub fn model_mm(pen: Pen, n: f64) -> f64 {
+    let off = |s: &f64| (s / n).ln().abs();
+    let nearest = SCALES.iter().copied().min_by(|a, b| off(a).total_cmp(&off(b)).then(a.total_cmp(b))).unwrap_or(96.0);
+    let k = (100.0 / nearest).powf(0.25);
+    match WIDTHS.get(usize::from(pen)) {
+        Some(&w) if pen > 0 => ((w * k * 100.0).round() / 100.0).clamp(0.01, 20.0),
+        _ => 0.0,
+    }
+}
+
+/// Millimetres of paper to points (a point is 1/72 in).
+pub fn points(mm: f64) -> f32 {
+    (mm * 72.0 / 25.4) as f32
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pens_widen_from_a_hairline() {
+        assert_eq!(annotation_mm(0), 0.0);
+        assert!((1..=MAX_PEN).all(|p| annotation_mm(p) > annotation_mm(p - 1)));
+        assert_eq!(annotation_mm(MAX_PEN + 1), 0.0);
+    }
+
+    #[test]
+    fn the_cuts_pen_is_wider_at_a_finer_scale() {
+        // 1/4" = 1'-0" is 1 : 48, a column of its own: (100 / 48) to the fourth root.
+        assert_eq!(model_mm(CUT, 48.0), 0.42);
+        assert_eq!(model_mm(CUT, 96.0), 0.35);
+        assert!(model_mm(CUT, 24.0) > model_mm(CUT, 48.0));
+        // Between two, the nearer by how many times.
+        assert_eq!(model_mm(CUT, 64.0), model_mm(CUT, 48.0));
+        assert_eq!(annotation_mm(PROJECTION), 0.18);
+    }
+}
diff --git a/plumbline/crates/world/src/paper/size.rs b/plumbline/crates/world/src/paper/size.rs
new file mode 100644
index 0000000..6c03284
--- /dev/null
+++ b/plumbline/crates/world/src/paper/size.rs
@@ -0,0 +1,102 @@
+//! The paper a plan set is written on, and the scale it is drawn at.
+//!
+//! PORTED CODE. Ported from BIMCraft at commit f202abd85d1cf165325e2f7b250da0b5e51f5b71
+//! (2026-11-10), https://github.com/IPedrax/bimcraft, Copyright (c) 2026 IPedrax and the
+//! BIMCraft contributors, used under the MIT license (BIMCraft is MIT OR Apache-2.0). The
+//! notice is in NOTICE at the repository root.
+//!
+//! What was changed, and nothing else:
+//! * The US architectural sizes ARCH A to D (`model::paper`, `crates/core/src/model.rs:1966`)
+//!   are taken, as BIMCraft gives them, landscape, in millimetres: 304.8 by 228.6, 457.2 by
+//!   304.8, 609.6 by 457.2, 914.4 by 609.6. The ISO, ANSI and the larger sizes, and a custom
+//!   size, are not taken: a plan set is written on these four. A size is named as BIMCraft
+//!   reads it ("ARCH A", "arch a", "ARCHA").
+//! * The scale's wording (`Units::scale`, `crates/core/src/units.rs:123`) is taken for the
+//!   architect's scales (an inch or a fraction of one to the foot): `1/4" = 1'-0"`. The
+//!   engineer's scales are not taken. Of the architect's, these five are the ones a plan
+//!   set is drawn at: 1/8, 3/16, 1/4, 3/8 and 1/2 in to the foot (what BIMCraft's
+//!   `IMPERIAL_SCALES` offers of them).
+
+/// A paper size: its name as it is lettered, and its width and height in inches (landscape).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Paper {
+    pub name: &'static str,
+    pub width_in: f64,
+    pub height_in: f64,
+}
+
+impl Paper {
+    /// Its width and height in points (1/72 in), as BIMCraft's millimetres come to.
+    pub fn points(&self) -> (f64, f64) {
+        (self.width_in * 72.0, self.height_in * 72.0)
+    }
+}
+
+/// ARCH A, B, C and D, smallest first.
+pub const PAPERS: [Paper; 4] = [
+    Paper { name: "ARCH A", width_in: 12.0, height_in: 9.0 },
+    Paper { name: "ARCH B", width_in: 18.0, height_in: 12.0 },
+    Paper { name: "ARCH C", width_in: 24.0, height_in: 18.0 },
+    Paper { name: "ARCH D", width_in: 36.0, height_in: 24.0 },
+];
+
+/// A paper size as typed: "ARCH A", "arch a", "archa".
+pub fn paper(name: &str) -> Option<Paper> {
+    let squeezed: String = name.trim().to_ascii_uppercase().chars().filter(|c| !c.is_whitespace()).collect();
+    PAPERS.iter().copied().find(|p| p.name.replace(' ', "") == squeezed)
+}
+
+/// The scales a plan set is drawn at, finest print last: inches of paper to the foot, as the
+/// drawing says them (numerator, denominator).
+pub const SCALES: [(u32, u32); 5] = [(1, 8), (3, 16), (1, 4), (3, 8), (1, 2)];
+
+/// Inches of paper to the foot at scale `(num, den)`.
+pub fn inches_to_the_foot(s: (u32, u32)) -> f64 {
+    f64::from(s.0) / f64::from(s.1)
+}
+
+/// 1 : n for scale `(num, den)`: 12 / inches to the foot (1/4 in is 1 : 48).
+pub fn ratio(s: (u32, u32)) -> f64 {
+    12.0 / inches_to_the_foot(s)
+}
+
+/// A scale as a drawing says it: `1/4" = 1'-0"`.
+pub fn scale_said(s: (u32, u32)) -> String {
+    format!("{}/{}\" = 1'-0\"", s.0, s.1)
+}
+
+/// A scale as typed: `1/4`, `1/4 in`, `1/4"`, `1/4" = 1'-0"`; one of the five, or none.
+pub fn scale(text: &str) -> Option<(u32, u32)> {
+    let t = text.trim().to_ascii_lowercase();
+    let t = t.split('=').next().unwrap_or("").trim();
+    let t = t.trim_end_matches("in").trim_end_matches('"').trim();
+    let (a, b) = t.split_once('/')?;
+    let s = (a.trim().parse::<u32>().ok()?, b.trim().parse::<u32>().ok()?);
+    SCALES.contains(&s).then_some(s)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_sizes_are_bimcrafts_in_points() {
+        assert_eq!(paper("ARCH A").map(|p| p.points()), Some((864.0, 648.0)));
+        assert_eq!(paper("arch c").map(|p| p.points()), Some((1728.0, 1296.0)));
+        assert_eq!(paper("ArchD").map(|p| p.name), Some("ARCH D"));
+        assert_eq!(paper("A4"), None);
+    }
+
+    #[test]
+    fn a_scale_is_said_as_a_drawing_says_it_and_read_as_typed() {
+        assert_eq!(scale_said((1, 4)), "1/4\" = 1'-0\"");
+        assert_eq!(ratio((1, 4)), 48.0);
+        assert_eq!(ratio((1, 2)), 24.0);
+        for typed in ["1/2 in", "1/2", "1/2\"", "1/2\" = 1'-0\"", " 1/2 IN "] {
+            assert_eq!(scale(typed), Some((1, 2)), "{typed}");
+        }
+        assert_eq!(scale("3/16"), Some((3, 16)));
+        assert_eq!(scale("1/3"), None);
+        assert_eq!(scale("1 in"), None);
+    }
+}
diff --git a/plumbline/crates/world/src/plan_set.rs b/plumbline/crates/world/src/plan_set.rs
new file mode 100644
index 0000000..3c83a4d
--- /dev/null
+++ b/plumbline/crates/world/src/plan_set.rs
@@ -0,0 +1,702 @@
+//! A plan set on paper: the plan of a level as it stands, the demolition plan and the
+//! proposed plan, each a page of line work (call 168). The drawing is data first (the walls
+//! with their weights, the dimensions as they are lettered, the rooms, the notes), and the
+//! PDF is that data drawn.
+//!
+//! The drawing passes are BIMCraft's, ported where each function says (`paper/`); this file
+//! is what BIMCraft has no function for and is ours: the pages (which of a level's things
+//! each shows, and how), a dimension string made along a wall by itself on the side away
+//! from the building, the rooms as they stand, a dash measured on paper, the notes, and the
+//! fitting of the plan to the paper at a scale. The model's own figures are what is
+//! lettered: a wall's length is its `plan_length` and a room's area its `floor_area`
+//! (`building::planset`), and the drawing never measures its own lines to letter a figure.
+
+use crate::building::planset::{level_named, level_plan, LevelPlan, LevelRoom};
+use crate::building::rooms;
+use crate::building::walls::{self, PlanWall};
+use crate::job::Job;
+use crate::paper::{self, cut, font, pen, size, Drawing, Prim, FAINT, INK, PAPER, POCHE};
+use crate::skeleton::P2 as V;
+use crate::value::Status;
+use plumbline_roofing::drawing::feet_written;
+
+/// How a thing is drawn on a page.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Weight {
+    /// New work, or everything on the page of a level with no mark: the cut's pen, its walls filled.
+    Heavy,
+    /// What stays, on a page that shows what is done to it: light, not filled.
+    Light,
+    /// What comes down: dashed.
+    Dashed,
+}
+
+impl Weight {
+    pub fn said(self) -> &'static str {
+        match self {
+            Weight::Heavy => "heavy",
+            Weight::Light => "light",
+            Weight::Dashed => "dashed",
+        }
+    }
+}
+
+/// What a page shows of the level.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Show {
+    /// A level with no mark on anything: all of it, heavy.
+    Floor,
+    /// What is marked existing or to demolish, as it stands, in full weight; new work is not on it.
+    Existing,
+    /// What stays, light; what comes down, dashed; new work is not on it.
+    Demolition,
+    /// What stays, light and unfilled; new work heavy and filled; what comes down is not on it.
+    Proposed,
+}
+
+impl Show {
+    pub fn name(self) -> &'static str {
+        match self {
+            Show::Floor => "FLOOR PLAN",
+            Show::Existing => "EXISTING PLAN",
+            Show::Demolition => "DEMOLITION PLAN",
+            Show::Proposed => "PROPOSED PLAN",
+        }
+    }
+    /// How a wall in `place` (0 to build, 1 existing, 2 to demolish) is drawn on this page,
+    /// or not at all.
+    fn weight(self, place: usize) -> Option<Weight> {
+        match (self, place) {
+            (Show::Floor, _) => Some(Weight::Heavy),
+            (Show::Existing, 1 | 2) => Some(Weight::Heavy),
+            (Show::Demolition, 1) => Some(Weight::Light),
+            (Show::Demolition, 2) => Some(Weight::Dashed),
+            (Show::Proposed, 1) => Some(Weight::Light),
+            (Show::Proposed, 0) => Some(Weight::Heavy),
+            _ => None,
+        }
+    }
+    /// Whether the rooms on this page are the rooms as they stand.
+    fn as_it_stands(self) -> bool {
+        matches!(self, Show::Existing | Show::Demolition)
+    }
+}
+

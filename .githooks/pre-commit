#!/usr/bin/env bash
# Nothing from a client's job leaves the local-only trees.
#
# This is a hook rather than a habit because twice it was a habit and twice it
# failed — a real number was in front of me while I wrote a test, and it went in.
#
# Turn it on once per clone:   git config core.hooksPath .githooks
exec bash "$(git rev-parse --show-toplevel)/tools/gate-clientdata.sh"

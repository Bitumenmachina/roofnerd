#!/usr/bin/env bash
# A commit does not go through until the three gates pass and everything the program is built
# from is in the commit. Turn it on once per clone:   git config core.hooksPath .githooks
#
# It is a hook and not a habit because twice it was a habit and twice it failed: a real number
# was in front of the builder while a test was written, and it went in.
#
# What it does not run: the tests and the demonstrations (plumbline/tools/check.sh, before work
# is accepted) and the build from a clean copy (plumbline/tools/committed.sh, before a push).
# Until 2026-11-26 this hook built and tested the earlier program at each commit, six minutes
# and 4 GB a time; that program left the branch (plumbline/DECISIONS.md call 237).
root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1
if ! { bash tools/gate-language.sh && bash tools/gate-egress.sh; }; then
  echo "commit refused: a gate failed"; exit 1
fi
# What a tool writes and a hand let go stale (plumbline/DECISIONS.md call 238): the index of
# decisions, the README's list of demonstrations, the table of what is linked, the manual's page.
if ! bash plumbline/tools/index.sh --check; then echo "commit refused: a list is stale"; exit 1; fi
if ! bash plumbline/tools/licenses.sh --check; then echo "commit refused: LICENSES.md is stale"; exit 1; fi
if ! python3 plumbline/tools/manual.py build --check; then echo "commit refused: the manual's page is stale"; exit 1; fi
exec bash "$root/tools/gate-clientdata.sh"

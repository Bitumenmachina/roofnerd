#!/usr/bin/env bash
# A commit does not go through until the tests and the three gates pass, and nothing from a
# client's job leaves the local-only trees.
#
# This is a hook rather than a habit because twice it was a habit and twice it failed — a real
# number was in front of me while I wrote a test, and it went in. The tests and gates joined it
# on 2026-09-12 so that "green before commit" is mechanical too (Addendum 6).
#
# Turn it on once per clone:   git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1
# Build first: the app type-checks against the engine's built dist, and a stale dist reads an
# engine change as an app error (it did, on 2026-09-12).
if ! pnpm -r build >/tmp/roofnerd-precommit.log 2>&1; then
  echo "commit refused: the build failed (see /tmp/roofnerd-precommit.log)"; tail -15 /tmp/roofnerd-precommit.log; exit 1
fi
if ! pnpm test >>/tmp/roofnerd-precommit.log 2>&1; then
  echo "commit refused: a test failed (see /tmp/roofnerd-precommit.log)"; tail -15 /tmp/roofnerd-precommit.log; exit 1
fi
# Braced on purpose: `! a && b` runs b only when a fails, which is the opposite of a gate.
if ! { bash tools/gate-language.sh && bash tools/gate-egress.sh; }; then
  echo "commit refused: a gate failed"; exit 1
fi
exec bash "$root/tools/gate-clientdata.sh"

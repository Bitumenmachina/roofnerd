{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "roofnerd",
  "version": "0.0.0",
  "identifier": "dev.roofnerd.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @roofnerd/app build",
    "beforeBuildCommand": "pnpm --filter @roofnerd/app build",
    "frontendDist": "../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "roofnerd",
        "width": 1560,
        "height": 880
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
